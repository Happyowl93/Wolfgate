reagent-effect-guidebook-wg-dose =
    { $chance ->
        [1] Gets
        *[other] get
    } the user high; purer product hits harder and builds dependence faster
reagent-effect-guidebook-wg-sedation =
    { $chance ->
        [1] Sedates
        *[other] sedate
    } the user, and past the overdose slows their breathing; tolerance and a weaker grade blunt it
reagent-effect-guidebook-wg-clear-intoxication =
    { $chance ->
        [1] Reverses
        *[other] reverse
    } the effects of { $family }

wg-drug-family-stimulant = stimulants
wg-drug-family-opioid = opioids
wg-drug-family-psychedelic = psychedelics
wg-drug-family-empathogen = empathogens
wg-drug-family-cannabinoid = cannabinoids
wg-drug-family-combat = combat drugs
wg-drug-family-nicotine = nicotine

## Phase changes: a high deepening, peaking dangerously, or letting go

wg-drug-phase-light = It's starting to kick in.
wg-drug-phase-heavy = It hits hard. You're well under now.
wg-drug-phase-overdose = Too much. Something is badly wrong with you.
wg-drug-phase-easing = The worst of it eases off.
wg-drug-phase-fading = You're coming down.

wg-nod-wake-1 = You jerk awake.
wg-nod-wake-2 = Your head snaps back up. How long were you out?
wg-nod-wake-3 = You blink hard. The world swims back.
wg-nod-emote-1 = nods off for a moment.
wg-nod-emote-2 = sways, eyes drooping shut.
wg-nod-emote-3 = drifts off mid-thought, then catches themselves.

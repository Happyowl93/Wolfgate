reagent-effect-guidebook-wf-dose =
    { $chance ->
        [1] Gets
        *[other] get
    } the user high; purer product hits harder and builds dependence faster
reagent-effect-guidebook-wf-sedation =
    { $chance ->
        [1] Sedates
        *[other] sedate
    } the user, and past the overdose slows their breathing; tolerance and a weaker grade blunt it
reagent-effect-guidebook-wf-clear-intoxication =
    { $chance ->
        [1] Reverses
        *[other] reverse
    } the effects of { $family }

wf-drug-family-stimulant = stimulants
wf-drug-family-opioid = opioids
wf-drug-family-psychedelic = psychedelics
wf-drug-family-empathogen = empathogens
wf-drug-family-cannabinoid = cannabinoids
wf-drug-family-combat = combat drugs
wf-drug-family-nicotine = nicotine

## Phase changes: a high deepening, peaking dangerously, or letting go

wf-drug-phase-light = It's starting to kick in.
wf-drug-phase-heavy = It hits hard. You're well under now.
wf-drug-phase-overdose = Too much. Something is badly wrong with you.
wf-drug-phase-easing = The worst of it eases off.
wf-drug-phase-fading = You're coming down.
